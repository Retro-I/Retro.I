{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "dependencyDashboard": true,

  "packageRules": [
    {
      "description": "Automerge Python formatting and linting tools",
      "matchPackageNames": [
        "black",
        "isort",
        "flake8"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor",
        "major"
      ],
      "automerge": true
    }
  ]
}
